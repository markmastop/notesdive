{
  "name": "notesdive",
  "private": true,
  "version": "0.18.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "release:mac": "tauri build --bundles dmg && node scripts/package-mac-release.mjs",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@marp-team/marp-core": "5.0.2",
    "@milkdown/kit": "^7.22.2",
    "@office-kit/pptx": "^0.21.0",
    "@office-kit/pptx-preview": "^0.12.0",
    "@tauri-apps/api": "^2.8.0",
    "html-to-pdfmake": "2.5.34",
    "html2canvas": "1.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "0.3.11",
    "postcss": "8.5.29",
    "postcss-value-parser": "4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remarkable-rm": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/html-to-pdfmake": "^2.4.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
